__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
secrets/

# Nested upstream checkouts (self-contained git repos holding the PR branches)
upstream/vllm/vllm/
upstream/exllamav3/exllamav3/
third_party/vllm-rocm-debug/

# hipify byproducts: the ROCm build compiles the rocm/exllamav3_ext/*.cu sources directly
# with hipcc (rocm/setup.py), so the .hip files beside them are one-off hipify output kept
# for reference, not build inputs.
rocm/exllamav3_ext/*.hip
rocm/exllamav3_ext/quant/*.hip
rocm/exllamav3_ext/arch_hip.cuh

# dbg2 bench: torch hipify regenerates dbg2/bench_gemv.hip from bench_gemv.cu when
# build_bench.py runs; deleting it forces a regen on the next build.
dbg2/*.hip
